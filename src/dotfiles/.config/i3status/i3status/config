general {
          colors = true
          interval = 1
          separator = "|"
}

#order += "cpu_usage"
#order += "ipv6"
#order += "wireless _first_"
#order += "ethernet _first_"
#order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"
order += "volume master"

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}

load {
        format = "%1min"
}

disk "/" {
        format = "%avail"
}

memory {
  memory_used_method = classical
  format="%used/%total"
}

volume master {
	format="♪: %volume"
	format_muted="♪:muted" 
}


