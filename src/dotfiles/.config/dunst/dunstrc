[global]
    width = 400
    offset = 5x5
    
    progress_bar_min_width = 380
    progress_bar_max_width = 380
    progress_bar_corner_radius = 2

    padding = 10
    horizontal_padding = 10
    frame_width = 1
    gap_size = 3
    font = "Mononoki Nerd Font 14"

    icon_theme = "ePapirus-Dark"
    enable_recursive_icon_lookup = true
    corner_radius = 2

    frame_color = "#89b4fa"
    separator_color= frame
    highlight = "#89b4fa"

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    default_icon = "dialog-information"
    format = "<b><span foreground='#cdd6f4'>%s</span></b>\n%b"

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    default_icon = "dialog-warning"
    format = "<b><span foreground='#cdd6f4'>%s</span></b>\n%b"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
    default_icon = "dialog-error"
    format = "<b><span foreground='#cdd6f4'>%s</span></b>\n%b"
