general {
          colors = true
          color_good = "#31748f"
          color_degraded = "#ebcb8b"
          color_bad = "#bf616a"
          interval = 1
          separator = "|"
}

order += "disk /"
order += "memory"
order += "tztime local"
order += "volume master"
order += "battery all"

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}

memory {
  memory_used_method = classical
  format="%used/%total"
}

volume master {
	format="♪: %volume"
	format_muted="♪:muted" 
}


battery all {
        format = "%status %percentage %remaining"
}
