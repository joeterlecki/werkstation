ARG NAME="werkstation-sway"
ARG BUN_URL="https://github.com/oven-sh/bun/releases/latest/download/bun-linux-x64.zip"
ARG ZEN_URL="https://github.com/zen-browser/desktop/releases/latest/download/zen.linux-x86_64.tar.xz"
ARG NERDFONTS_VERSION="3.4.0"
ARG FONT_NAME="CascadiaMono"
ARG NERDFONTS_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/v${NERDFONTS_VERSION}/${FONT_NAME}.zip"

FROM busybox AS bun
ARG BUN_URL
RUN wget -q ${BUN_URL} -O ./bun-linux-x64.zip \
    && unzip ./bun-linux-x64.zip -d ./ \
    && rm ./bun-linux-x64.zip

FROM busybox AS zen
ARG ZEN_URL
RUN wget -q ${ZEN_URL} -O ./zen.tar.xz \
    && tar -xJf ./zen.tar.xz \
    && mkdir -p /zen-install/usr/lib/zen \
    && mkdir -p /zen-install/usr/share/applications \
    && mkdir -p /zen-install/usr/share/icons/hicolor/128x128/apps \
    && mv zen/* /zen-install/usr/lib/zen/ \
    && cp /zen-install/usr/lib/zen/browser/chrome/icons/default/default128.png \
    /zen-install/usr/share/icons/hicolor/128x128/apps/zen.png \
    && rm ./zen.tar.xz

FROM busybox AS nerdfonts
ARG NERDFONTS_URL
RUN wget -q ${NERDFONTS_URL} -O ./font.zip \
    && mkdir -p /fonts-install/usr/local/share/fonts \
    && unzip ./font.zip -d /fonts-install/usr/local/share/fonts/ \
    && rm ./font.zip

FROM quay.io/fedora-ostree-desktops/sway-atomic:42 as release
ARG NAME

COPY --from=bun /bun-linux-x64/bun /usr/local/bin/
COPY --from=zen /zen-install/usr /usr/
COPY --from=nerdfonts /fonts-install/usr /usr/

RUN echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-ip-forward.conf \
    && echo "net.ipv6.conf.all.forwarding=1" >> /etc/sysctl.d/99-ip-forward.conf

RUN dnf5 config-manager addrepo --from-repofile='https://pkgs.tailscale.com/stable/fedora/tailscale.repo' \
    && rpm-ostree install \
    https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-42.noarch.rpm \
    https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-42.noarch.rpm

RUN dnf5 install -y \
    alacritty \
    curl \
    golang \
    jq \
    neovim \
    ripgrep \
    stow \
    tailscale \
    tmux \
    tree-sitter-cli \
    zsh \
    && dnf clean all

RUN ln -s /usr/lib/zen/zen /usr/bin/zen \
    && chmod +x /usr/bin/zen

COPY ./desktop-entries/zen.desktop /usr/share/applications/zen.desktop

RUN rpm-ostree override remove firefox firefox-langpacks \
    && rpm-ostree cleanup -m \
    && ostree container commit

LABEL name="${NAME}" \
    summary="Fedora atomic sway with developer tools" \
    maintainer="Joe Terlecki" \
    org.opencontainers.image.source="https://github.com/joeterlecki/werkstation" \
    org.opencontainers.image.description="Sway-based Fedora Atomic container with Bun, Zen Browser, and development tools" \
    org.opencontainers.image.version="42"
